# AWS Configuration
aws_region   = "us-east-1"
project_name = "k8s-cluster"
environment  = "dev"

# VPC Configuration
vpc_cidr             = "10.0.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b", "us-east-1c"]
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24", "10.0.13.0/24"]

# Bastion Configuration
bastion_instance_type = "t3.micro"
bastion_enable_ssm    = true

# Control Plane Configuration
control_plane_count            = 3
control_plane_instance_type    = "t3.medium"
control_plane_root_volume_size = 50

# Worker Node Configuration
worker_node_count         = 3
worker_instance_type      = "t3.medium"
worker_root_volume_size   = 50

# SSH Configuration
key_name          = "your-key-pair-name"
allowed_ssh_cidrs = ["0.0.0.0/0"]  # Restrict this in production

# Gateway API / Load Balancer Configuration
# These must match the NodePorts used by your Cilium Gateway service
gateway_http_nodeport  = 32540  # HTTP NodePort (check: kubectl get svc -n <namespace>)
gateway_https_nodeport = 31608  # HTTPS NodePort (check: kubectl get svc -n <namespace>)

# ArgoCD NLB Configuration (Optional)
# Set enable_argocd_nlb = true to expose ArgoCD via NLB
enable_argocd_nlb      = false  # Set to true to enable
argocd_nodeport        = 30080  # Kubernetes NodePort for ArgoCD
argocd_listener_port   = 8080   # External port on NLB (access via http://<nlb-dns>:8080)
